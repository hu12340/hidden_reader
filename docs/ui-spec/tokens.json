{
  "$schema": "hiddenreader-ui-tokens-v1",
  "meta": {
    "designSource": "https://ardot.tencent.com/file/745554518740440",
    "specDoc": "UI-SPEC.md",
    "reviewDoc": "REVIEW-UI.md",
    "date": "2026-11-09",
    "fontFamily": "Noto Sans SC（UI 中文）；Inter（数字、HEX、百分比）"
  },
  "color": {
    "bg": {
      "window": "#1E1F26",
      "surface": "#242A35",
      "toc": "#1B2029",
      "input": "#141821",
      "hexBox": "#15161C"
    },
    "border": {
      "divider": "#303641",
      "control": "#414B5C",
      "tocDivider": "#262C36",
      "input": "#495466",
      "secondaryButton": "#4A4C58",
      "dangerButton": "#5A3A42",
      "menuDivider": "#3A4351",
      "floatLine": "#8A8A99"
    },
    "text": {
      "primary": "#E5E8EE",
      "reading": "#E4E2DC",
      "secondary": "#B6C1D0",
      "secondaryAlt": "#B0BACA",
      "tertiary": "#9BA7B8",
      "muted": "#7E8896",
      "faint": "#6F7A8A",
      "tocRead": "#7C8794",
      "tocUnread": "#A9B3C2",
      "iconIdle": "#AFC5E2",
      "menuIcon": "#A8B8CE",
      "windowBtn": "#A9B3C2",
      "exitDanger": "#C9A0A6",
      "removeDanger": "#FFBDC3",
      "shortcut": "#8A94A3"
    },
    "state": {
      "hoverTopbar": "#343B48",
      "pressedTopbar": "#3E4654",
      "hoverCommand": "#31394A",
      "hoverShelfRow": "#303845",
      "selected": "#263954",
      "selectedTile": "#354D76",
      "removeHover": "#573642",
      "closeHover": "#C42B1C"
    },
    "accent": {
      "default": "#6FA8F5",
      "text": "#9BC4FF",
      "iconOnSelected": "#D8E8FF"
    },
    "buttons": {
      "primary": { "bg": "#A3C8FF", "fg": "#162133" },
      "secondary": { "bg": "#2C2E38", "fg": "#E4E2DC" },
      "danger": { "bg": "#3A2E34", "fg": "#FFBDC3" }
    },
    "highlight": {
      "match": "#A3C8FF33",
      "current": "#A3C8FF6B",
      "selection": "#6FA8F580",
      "zOrder": "selection > current > match"
    },
    "reading": {
      "backgroundDefault": "#000000",
      "textDefault": "#E4E2DC"
    },
    "floatWindow": {
      "backgroundDefault": "#0A0A0B",
      "note": "底色与描边的 alpha 由背景/边框不透明度(0-100%)分别驱动"
    }
  },
  "typography": {
    "chapterTitle": { "size": 22, "lineHeight": 34, "weight": "SemiBold" },
    "body": { "size": 15, "lineHeight": 30, "weight": "Regular" },
    "floatTitle": { "size": 17, "lineHeight": 26, "weight": "SemiBold" },
    "floatBody": { "size": 13, "lineHeight": 26, "weight": "Regular" },
    "panelTitle": { "size": 13, "weight": "Medium" },
    "itemTitle": { "size": 13, "weight": "Regular" },
    "itemTitleMedium": { "size": 13, "weight": "Medium" },
    "bodySmall": { "size": 12, "weight": "Regular" },
    "caption": { "size": 11, "weight": "Regular" },
    "groupLabel": { "size": 10, "weight": "Medium", "lineHeight": 16 },
    "shortcut": { "size": 11, "family": "Inter" }
  },
  "shape": {
    "radius": { "small": 3, "button": 5, "popup": 8, "board": 10 },
    "iconSize": 16,
    "windowBtnIcon": 12
  },
  "layout": {
    "topbar": { "height": 44, "paddingLeft": 8, "gap": 2, "iconButton": 32 },
    "toc": { "width": 236, "headerHeight": 40, "rowHeight": 34, "currentRowHeight": 54, "accentBarWidth": 2 },
    "statusbar": { "height": 38, "pageBox": { "w": 46, "h": 24 }, "pageButton": 26 },
    "readingPadding": { "top": 38, "sides": 46, "bottom": 28, "paragraphGap": 20 },
    "shelfPopup": { "width": 404, "maxListHeight": 360, "rowHeight": 50, "headerHeight": 30 },
    "floatMenu": { "width": 220, "itemHeight": 32, "padding": 5, "gap": 1 },
    "opacityPanel": { "width": 320, "padding": 16, "sliderTrackHeight": 4, "knob": 14 },
    "colorsPanel": { "width": 420, "swatchHeight": 30, "hexBoxWidth": 104, "pickerButtonWidth": 52 },
    "dialogButton": { "height": 32, "cancelWidth": 64, "okWidth": 64, "restoreWidth": 78 }
  },
  "floatMenuOrder": [
    { "group": "显示", "items": ["背景不透明度（显示当前值）", "边框不透明度（显示当前值）", "阅读配色…", "正文字号…"] },
    { "group": "窗口", "items": ["置顶（勾选态）", "返回普通模式（标注 Esc）"] },
    { "group": null, "items": ["退出（危险色）"] }
  ]
}
