<Window x:Class="HiddenReader.App.UI.ReadingColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="阅读配色"
        Width="396" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1F26" Foreground="#E4E2DC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C2E38"/>
            <Setter Property="Foreground" Value="#E4E2DC"/>
            <Setter Property="BorderBrush" Value="#4A4C58"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15161C"/>
            <Setter Property="Foreground" Value="#E4E2DC"/>
            <Setter Property="BorderBrush" Value="#4A4C58"/>
            <Setter Property="CaretBrush" Value="#E4E2DC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A98A0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderBrush" Value="#4A4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="点击选择颜色"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,14,16,16">
        <TextBlock Style="{StaticResource Label}" Text="配色对普通模式和极简浮窗的所有书籍生效。"/>
        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2" Text="正文文字"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="TextSwatch" Grid.Column="0" Style="{StaticResource Swatch}"
                    MouseLeftButtonDown="OnTextSwatchClick"/>
            <TextBox x:Name="TextHexBox" Grid.Column="1" Width="96" Margin="8,0,0,0" MaxLength="7"
                     TextChanged="OnTextHexChanged" LostFocus="OnHexLostFocus"/>
            <Button x:Name="TextPickButton" Grid.Column="2" Content="吸管" Width="52" Margin="8,0,0,0"
                    Click="OnPickText"/>
        </Grid>
        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2" Text="阅读背景"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="BackgroundSwatch" Grid.Column="0" Style="{StaticResource Swatch}"
                    MouseLeftButtonDown="OnBackgroundSwatchClick"/>
            <TextBox x:Name="BackgroundHexBox" Grid.Column="1" Width="96" Margin="8,0,0,0" MaxLength="7"
                     TextChanged="OnTextHexChanged" LostFocus="OnHexLostFocus"/>
            <Button x:Name="BackgroundPickButton" Grid.Column="2" Content="吸管" Width="52" Margin="8,0,0,0"
                    Click="OnPickBackground"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RestoreButton" Content="恢复默认" Width="80" Click="OnRestoreDefaults"/>
            <Button x:Name="CancelButton" Content="取消" Width="64" Margin="16,0,0,0" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Content="确定" Width="64" Margin="8,0,0,0" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
