<Application x:Class="HiddenReader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!--
      对话框级共享资源（UI-SPEC 2.4 / UI-08）：窗口底色与三档按钮样式全应用唯一来源。
      配色/字号/帮助窗口、不透明度面板与编码对话框引用这里的资源，
      禁止各窗口内联私有按钮灰度。悬停/按下取值映射自 tokens.json 的状态色：
      主按钮悬停 accent.iconOnSelected、按下 accent.default；次按钮悬停/按下
      用 state.hoverTopbar/pressedTopbar；危险按钮悬停用 state.removeHover。
    -->
    <Application.Resources>
        <SolidColorBrush x:Key="DialogWindowBrush" Color="#1E1F26"/>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#414B5C"/>
        <SolidColorBrush x:Key="DialogForegroundBrush" Color="#E4E2DC"/>
        <!-- 说明文字（11px text.muted）与次要文字（12px text.tertiary） -->
        <Style x:Key="DialogHintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E8896"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="DialogSecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9BA7B8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 次按钮：灰底描边（取消、恢复默认） -->
        <Style x:Key="DialogSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2E38"/>
            <Setter Property="Foreground" Value="#E4E2DC"/>
            <Setter Property="BorderBrush" Value="#4A4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#343B48"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E4654"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主按钮：蓝底深字，「确定」每屏唯一 -->
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Background" Value="#A3C8FF"/>
            <Setter Property="Foreground" Value="#162133"/>
            <Setter Property="BorderBrush" Value="#A3C8FF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8E8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6FA8F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 危险按钮：暗红底红字（本轮仅预留；移除按钮仍由书架行内悬停态承担） -->
        <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Background" Value="#3A2E34"/>
            <Setter Property="Foreground" Value="#FFBDC3"/>
            <Setter Property="BorderBrush" Value="#5A3A42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#573642"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <!-- 按下态沿用悬停值 #573642：tokens 未定义更深的危险色，不私造取值 -->
                                <Setter TargetName="Bd" Property="Background" Value="#573642"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
