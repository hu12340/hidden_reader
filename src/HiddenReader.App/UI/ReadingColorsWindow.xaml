<Window x:Class="HiddenReader.App.UI.ReadingColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="阅读配色"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource DialogWindowBrush}" Foreground="{StaticResource DialogForegroundBrush}">
    <!--
      阅读配色面板（UI-SPEC 2.4）：宽度 420，底色 bg.window，描边补 border.control；
      按钮行收敛为共享三档体系：恢复默认(次) 靠左 + 取消(次) + 确定(主)。行结构不变。
    -->
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15161C"/>
            <Setter Property="Foreground" Value="#E4E2DC"/>
            <Setter Property="BorderBrush" Value="#4A4C58"/>
            <Setter Property="CaretBrush" Value="#E4E2DC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A98A0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="#4A4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="点击选择颜色"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1">
        <StackPanel Margin="15,13,15,15">
            <TextBlock Style="{StaticResource DialogSecondaryText}" Text="配色对普通模式和极简浮窗的所有书籍生效。"/>
            <TextBlock Style="{StaticResource Label}" Margin="0,8,0,2" Text="正文文字"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="TextSwatch" Grid.Column="0" Style="{StaticResource Swatch}"
                        MouseLeftButtonDown="OnTextSwatchClick"/>
                <TextBox x:Name="TextHexBox" Grid.Column="1" Width="104" Margin="8,0,0,0" MaxLength="7"
                         TextChanged="OnTextHexChanged" LostFocus="OnHexLostFocus"/>
                <Button x:Name="TextPickButton" Grid.Column="2" Style="{StaticResource DialogSecondaryButton}"
                        Content="吸管" Width="52" Height="30" Margin="8,0,0,0"
                        Click="OnPickText"/>
            </Grid>
            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2" Text="阅读背景"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BackgroundSwatch" Grid.Column="0" Style="{StaticResource Swatch}"
                        MouseLeftButtonDown="OnBackgroundSwatchClick"/>
                <TextBox x:Name="BackgroundHexBox" Grid.Column="1" Width="104" Margin="8,0,0,0" MaxLength="7"
                         TextChanged="OnTextHexChanged" LostFocus="OnHexLostFocus"/>
                <Button x:Name="BackgroundPickButton" Grid.Column="2" Style="{StaticResource DialogSecondaryButton}"
                        Content="吸管" Width="52" Height="30" Margin="8,0,0,0"
                        Click="OnPickBackground"/>
            </Grid>
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button x:Name="RestoreButton" DockPanel.Dock="Left" Style="{StaticResource DialogSecondaryButton}"
                        Content="恢复默认" Width="78" Click="OnRestoreDefaults"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Style="{StaticResource DialogSecondaryButton}"
                            Content="取消" Width="64" Margin="0,0,8,0" Click="OnCancel"/>
                    <Button x:Name="ConfirmButton" Style="{StaticResource DialogPrimaryButton}"
                            Content="确定" Width="64" Click="OnConfirm"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
