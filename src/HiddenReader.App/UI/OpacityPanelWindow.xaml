<Window x:Class="HiddenReader.App.UI.OpacityPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="不透明度" Width="320" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{StaticResource DialogWindowBrush}" Foreground="{StaticResource DialogForegroundBrush}">
    <!--
      浮窗不透明度面板（UI-SPEC 2.4 / UI-03）：宽 320、内距 16、组距 14；
      背景/边框两组滑杆实时预览，「确定」原子保存、「取消」回滚打开前值。
      滑杆轨道 4px #39404D、已选段 accent.default、滑块 14px #E8EEF9 带投影。
    -->
    <Window.Resources>
        <Style x:Key="OpacitySlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSelectionRangeEnabled" Value="True"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#39404D" VerticalAlignment="Center"/>
                            <Border x:Name="PART_SelectionRange" Height="4" CornerRadius="2" Background="#6FA8F5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="16"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="16"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#E8EEF9">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1">
        <StackPanel Margin="16">
            <DockPanel LastChildFill="False">
                <TextBlock Text="不透明度" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DialogHintText}"
                           Text="仅影响浮窗底色与描边" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="背景" FontSize="12" Foreground="#B6C1D0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BackgroundValue" DockPanel.Dock="Right" FontSize="12"
                           FontFamily="Consolas" Foreground="#9BC4FF" VerticalAlignment="Center"/>
            </DockPanel>
            <Slider x:Name="BackgroundSlider" Margin="0,4,0,0" Style="{StaticResource OpacitySlider}"
                    AutomationProperties.Name="背景不透明度"/>
            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="边框" FontSize="12" Foreground="#B6C1D0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BorderValue" DockPanel.Dock="Right" FontSize="12"
                           FontFamily="Consolas" Foreground="#9BC4FF" VerticalAlignment="Center"/>
            </DockPanel>
            <Slider x:Name="BorderSlider" Margin="0,4,0,0" Style="{StaticResource OpacitySlider}"
                    AutomationProperties.Name="边框不透明度"/>
            <Separator Margin="0,14,0,0" Background="#303641"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource DialogSecondaryButton}"
                        Content="取消" Width="64" Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource DialogPrimaryButton}"
                        Content="确定" Width="64" IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
