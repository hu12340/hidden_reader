<Window x:Class="HiddenReader.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:HiddenReader.App.UI"
        Title="HiddenReader"
        Icon="/Assets/HiddenReader.ico"
        Width="900" Height="640"
        Background="#1E1F26"
        Foreground="#E4E2DC">
    <!--
      自定义顶部栏（顶部菜单原型）：客户区内绘制整个标题栏。
      CaptionHeight 覆盖顶部栏高度，未标记 IsHitTestVisibleInChrome 的区域由系统
      处理拖动与双击最大化；菜单、浮窗图标和窗口按钮必须标记者，否则会被拖动命中拦截。
      ResizeBorderThickness 保留边缘缩放；GlassFrameThickness=0 不显示 DWM 玻璃边框。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 图标几何（16×16 线稿，描边风格与顶部菜单原型一致） -->
        <Geometry x:Key="BookIcon">M8 4C5.5 2 3 2 1.5 3v9c2-1 4.3-1 6.5 1 2.2-2 4.5-2 6.5-1V3C13 2 10.5 2 8 4v9</Geometry>
        <Geometry x:Key="EyeIcon">M1 8s2.5-4.5 7-4.5S15 8 15 8s-2.5 4.5-7 4.5S1 8 1 8z M6.2 8a1.8 1.8 0 1 0 3.6 0 1.8 1.8 0 0 0-3.6 0</Geometry>
        <Geometry x:Key="GearIcon">M6.6 1.5h2.8l.3 1.8 1.2.7 1.7-.7L14 5.7l-1.4 1.2v2.2l1.4 1.2-1.4 2.4-1.7-.7-1.2.7-.3 1.8H6.6l-.3-1.8-1.2-.7-1.7.7L2 10.3l1.4-1.2V6.9L2 5.7l1.4-2.4 1.7.7 1.2-.7z M5.9 8a2.1 2.1 0 1 0 4.2 0 2.1 2.1 0 0 0-4.2 0</Geometry>
        <Geometry x:Key="HelpIcon">M8 1.6a6.4 6.4 0 1 0 0 12.8A6.4 6.4 0 0 0 8 1.6z M6 6a2 2 0 1 1 3.4 1.5C8.4 8.3 8 8.5 8 9.5 M8 11.5h.01</Geometry>
        <Geometry x:Key="KeyboardIcon">M3 3.5h10a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H3A1.5 1.5 0 0 1 1.5 11V5A1.5 1.5 0 0 1 3 3.5z M4 6.5h.1M6.5 6.5h.1M9 6.5h.1M11.5 6.5h.1M4 9.5h.1M6.5 9.5h5.4</Geometry>
        <Geometry x:Key="AddIcon">M3 1.5h6.5l3 3v10h-9zM9 1.5V5h3.5M5.5 9.5h4.5M7.75 7.25v4.5</Geometry>
        <Geometry x:Key="FloatIcon">M3.5 2h9a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M7.5 7.5h5v3.8h-5z</Geometry>
        <Geometry x:Key="ListIcon">M5 4h9M5 8h9M5 12h9M2 4h.1M2 8h.1M2 12h.1</Geometry>
        <Geometry x:Key="SearchIcon">M7 2.8a4.2 4.2 0 1 0 0 8.4 4.2 4.2 0 0 0 0-8.4z M10 10l3.5 3.5</Geometry>
        <Geometry x:Key="ColorIcon">M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2z M8 2v12M8 5l3-2M8 8l5-3M8 11l6-3M8 14l5-3</Geometry>
        <Geometry x:Key="CloseIcon">M4 4l8 8M12 4l-8 8</Geometry>
        <Geometry x:Key="UpIcon">M4 10l4-4 4 4</Geometry>
        <Geometry x:Key="DownIcon">M4 6l4 4 4-4</Geometry>
        <Geometry x:Key="LeftIcon">M10 4L6 8l4 4</Geometry>
        <Geometry x:Key="RightIcon">M6 4l4 4-4 4</Geometry>
        <Geometry x:Key="MinIcon">M2 8h12</Geometry>
        <Geometry x:Key="MaxIcon">M2.5 2.5h11v11h-11z</Geometry>
        <Geometry x:Key="RestoreIcon">M4.5 6.5V3.5h8v9h-3M4.5 6.5h5v6h-5z</Geometry>
        <!-- 16×16 线稿图标的公共外观 -->
        <Style x:Key="GlyphIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
            <Setter Property="StrokeThickness" Value="1.55"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- 顶部栏按钮：透明底，悬停 #343B48；必须是命中可见区，否则被标题栏拖动拦截 -->
        <Style x:Key="TopBarButton" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E8EE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#343B48"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E4654"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 窗口控制按钮（最小化/最大化/关闭），关闭键悬停红色 -->
        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource TopBarButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#343B48"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E4654"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="close">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="close"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 菜单命令行（弹层内整行按钮） -->
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E8EE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#31394A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 弹层菜单容器 -->
        <Style x:Key="FlyoutBorder" TargetType="Border">
            <Setter Property="Background" Value="#242A35"/>
            <Setter Property="BorderBrush" Value="#414B5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="MenuIcon" TargetType="Path" BasedOn="{StaticResource GlyphIcon}">
            <Setter Property="Stroke" Value="#A8B8CE"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#141821"/>
            <Setter Property="Foreground" Value="#E5E8EE"/>
            <Setter Property="BorderBrush" Value="#495466"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#E5E8EE"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- 书架行 × 按钮：悬停底色偏红，图标随之变亮 -->
        <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#573642"/>
                                <Setter Property="Foreground" Value="#FFBDC3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 书架行：书名整行按钮 + 独立 × -->
        <DataTemplate x:Key="ShelfItemTemplate">
            <Border x:Name="Row" CornerRadius="5" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="OnShelfBookClick" Style="{StaticResource CommandButton}"
                            ToolTip="{Binding Book.Title}" Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource BookIcon}" Style="{StaticResource MenuIcon}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Book.Title}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="✓" Foreground="#9BC4FF" Margin="8,0,2,0"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" x:Name="RemoveButton" Click="OnShelfRemoveClick" Tag="{Binding Book}"
                            ToolTip="从书架移除" Height="29" Width="30"
                            Style="{StaticResource RemoveButton}" Padding="0">
                        <Path Data="{StaticResource CloseIcon}" Style="{StaticResource GlyphIcon}" Width="12" Height="12"/>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#263954"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#303845"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
    <Border x:Name="RootBorder" Background="#1E1F26">
        <DockPanel>
            <!-- 顶部栏：应用图标 + 书页/眼睛/齿轮/问号/极简浮窗五个图标入口 + 窗口按钮 -->
            <Border DockPanel.Dock="Top" Height="44" Background="#1E1F26"
                    BorderBrush="#303641" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <!-- 应用图标（装饰，不参与命中拖动之外的行为） -->
                    <Border Width="23" Height="23" CornerRadius="5" Background="#354D76"
                            VerticalAlignment="Center" Margin="12,0,12,0">
                        <Path Data="{StaticResource BookIcon}" Style="{StaticResource GlyphIcon}"
                              Stroke="#D8E8FF" Width="14" Height="14"/>
                    </Border>
                    <!-- 左侧图标组：书页、眼睛、齿轮、问号、极简浮窗（顺序与原型一致） -->
                    <Button x:Name="BookButton" DockPanel.Dock="Left" Width="32" Padding="0"
                            Style="{StaticResource TopBarButton}" Click="OnFileMenuClick"
                            ToolTip="书架与导入" AutomationProperties.Name="书架与导入">
                        <Path Data="{StaticResource BookIcon}" Style="{StaticResource GlyphIcon}" Stroke="#AFC5E2"/>
                    </Button>
                    <Button x:Name="EyeButton" DockPanel.Dock="Left" Width="32" Padding="0"
                            Style="{StaticResource TopBarButton}" Click="OnViewMenuClick"
                            ToolTip="查看" AutomationProperties.Name="查看">
                        <Path Data="{StaticResource EyeIcon}" Style="{StaticResource GlyphIcon}" Stroke="#AFC5E2"/>
                    </Button>
                    <Button x:Name="GearButton" DockPanel.Dock="Left" Width="32" Padding="0"
                            Style="{StaticResource TopBarButton}" Click="OnSettingsMenuClick"
                            ToolTip="设置" AutomationProperties.Name="设置">
                        <Path Data="{StaticResource GearIcon}" Style="{StaticResource GlyphIcon}" Stroke="#AFC5E2"/>
                    </Button>
                    <Button x:Name="HelpButton" DockPanel.Dock="Left" Width="32" Padding="0"
                            Style="{StaticResource TopBarButton}" Click="OnHelpMenuClick"
                            ToolTip="帮助" AutomationProperties.Name="帮助">
                        <Path Data="{StaticResource HelpIcon}" Style="{StaticResource GlyphIcon}" Stroke="#AFC5E2"/>
                    </Button>
                    <!-- 极简浮窗：左侧图标组的最后一项 -->
                    <Button x:Name="FloatButton" DockPanel.Dock="Left"
                            Style="{StaticResource TopBarButton}" Click="OnEnterFloat"
                            ToolTip="极简浮窗" AutomationProperties.Name="极简浮窗" Padding="0" Width="32">
                        <Path Data="{StaticResource FloatIcon}" Style="{StaticResource GlyphIcon}" Stroke="#AFC5E2"/>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}"
                                Click="OnMinimize" ToolTip="最小化">
                            <Path Data="{StaticResource MinIcon}" Style="{StaticResource GlyphIcon}" Stroke="#A9B3C2" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}"
                                Click="OnMaximizeRestore" ToolTip="最大化">
                            <Grid>
                                <Path x:Name="MaxGlyph" Data="{StaticResource MaxIcon}" Style="{StaticResource GlyphIcon}" Stroke="#A9B3C2" Width="12" Height="12"/>
                                <Path x:Name="RestoreGlyph" Data="{StaticResource RestoreIcon}" Style="{StaticResource GlyphIcon}" Stroke="#A9B3C2" Width="12" Height="12" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource WindowButton}" Tag="close"
                                Click="OnCloseWindow" ToolTip="关闭">
                            <Path Data="{StaticResource CloseIcon}" Style="{StaticResource GlyphIcon}" Stroke="#A9B3C2" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 搜索栏：按需显示 -->
            <Border x:Name="FindBarRow" DockPanel.Dock="Top" Visibility="Collapsed"
                    Background="#1E1F26" BorderBrush="#303641" BorderThickness="0,0,0,1"
                    Padding="9,6">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Width="230" KeyDown="OnSearchKeyDown"/>
                            <TextBlock Text="搜索当前小说" Foreground="#9BA7B8" Margin="7,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       x:Name="SearchPlaceholder"/>
                        </Grid>
                        <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" MinWidth="42"
                                   Margin="6,0" Foreground="#9BA7B8" FontSize="12" TextAlignment="Center"/>
                        <Button x:Name="PrevHitButton" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                Click="OnPrevHit" ToolTip="上一处" AutomationProperties.Name="上一处">
                            <Path Data="{StaticResource UpIcon}" Style="{StaticResource GlyphIcon}" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="NextHitButton" Style="{StaticResource IconButton}"
                                Click="OnNextHit" ToolTip="下一处" AutomationProperties.Name="下一处">
                            <Path Data="{StaticResource DownIcon}" Style="{StaticResource GlyphIcon}" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnCloseFind"
                                ToolTip="关闭搜索" AutomationProperties.Name="关闭搜索">
                            <Path Data="{StaticResource CloseIcon}" Style="{StaticResource GlyphIcon}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 底部状态栏：章节/阶段文字 + 上一页 / 页码输入 / 总页数 / 下一页 -->
            <Border DockPanel.Dock="Bottom" MinHeight="38" Background="#1E1F26"
                    BorderBrush="#303641" BorderThickness="0,1,0,0" Padding="10,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PrevPageButton" Style="{StaticResource IconButton}"
                                Click="OnPrevPage" ToolTip="上一页" AutomationProperties.Name="上一页">
                            <Path Data="{StaticResource LeftIcon}" Style="{StaticResource GlyphIcon}" Width="14" Height="14"/>
                        </Button>
                        <TextBox x:Name="PageBox" Width="44" KeyDown="OnPageKeyDown" Margin="4,0,4,0"
                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                 ToolTip="输入页码后按回车" AutomationProperties.Name="跳至页，输入页码后按回车"/>
                        <TextBlock x:Name="PageTotal" VerticalAlignment="Center" Foreground="#9BA7B8"
                                   FontSize="12" Margin="0,0,6,0" Text="页"/>
                        <Button x:Name="NextPageButton" Style="{StaticResource IconButton}"
                                Click="OnNextPage" ToolTip="下一页" AutomationProperties.Name="下一页">
                            <Path Data="{StaticResource RightIcon}" Style="{StaticResource GlyphIcon}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                    <Path Data="{StaticResource BookIcon}" Style="{StaticResource GlyphIcon}"
                          Stroke="#B0BACA" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PageLabel" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#B0BACA" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 目录：按需展开 -->
                <Border x:Name="TocPanel" Width="220" Visibility="Collapsed" Background="#1B2029"
                        BorderBrush="#303641" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,10,8,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Click="OnToggleToc" ToolTip="关闭目录" AutomationProperties.Name="关闭目录">
                                <Path Data="{StaticResource CloseIcon}" Style="{StaticResource GlyphIcon}" Width="12" Height="12"/>
                            </Button>
                            <TextBlock Text="目录" Foreground="#9BA7B8" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="TocList" SelectionChanged="OnChapterSelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#E4E2DC"
                                 VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </DockPanel>
                </Border>
                <local:ReadingView x:Name="Reader" Grid.Column="1"/>
            </Grid>
        </DockPanel>
    </Border>

    <!-- 书架菜单弹层（置于窗口元素之外，避免参与布局） -->
    <Popup x:Name="FileMenuPopup" PlacementTarget="{Binding ElementName=BookButton}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
           Closed="OnFileMenuPopupClosed" VerticalOffset="4">
        <Border Style="{StaticResource FlyoutBorder}" Width="308">
            <StackPanel>
                <Button Click="OnImport" Style="{StaticResource CommandButton}" x:Name="ImportButton">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}" Style="{StaticResource MenuIcon}"/>
                        <TextBlock Text="导入 TXT…" VerticalAlignment="Center"/>
                        <TextBlock Text="Ctrl+O" Margin="18,0,0,0" Foreground="#9BA7B8" FontSize="11"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </Button>
                <DockPanel Margin="8,7,8,2">
                    <TextBlock DockPanel.Dock="Right" x:Name="ShelfCountText" Text="0 本"
                               Foreground="#9BA7B8" FontSize="11"/>
                    <TextBlock Text="书架" Foreground="#9BA7B8" FontSize="11"/>
                </DockPanel>
                <ScrollViewer MaxHeight="225" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ShelfList" ItemTemplate="{StaticResource ShelfItemTemplate}"/>
                </ScrollViewer>
                <TextBlock x:Name="ShelfEmptyText" Margin="9,6,9,9" Foreground="#9BA7B8" FontSize="12"
                           TextWrapping="Wrap" Text="书架为空，点击顶部的书页图标导入一本 TXT 小说。"/>
            </StackPanel>
        </Border>
    </Popup>

    <!-- 查看菜单弹层 -->
    <Popup x:Name="ViewMenuPopup" PlacementTarget="{Binding ElementName=EyeButton}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
           Closed="OnViewMenuPopupClosed" VerticalOffset="4">
        <Border Style="{StaticResource FlyoutBorder}" Width="204">
            <StackPanel>
                <Button Click="OnToggleTocFromMenu" Style="{StaticResource CommandButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ListIcon}" Style="{StaticResource MenuIcon}"/>
                        <TextBlock Text="目录" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TocCheck" Text="✓" Margin="14,0,2,0" Foreground="#9BC4FF"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Click="OnSearchFromMenu" Style="{StaticResource CommandButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SearchIcon}" Style="{StaticResource MenuIcon}"/>
                        <TextBlock Text="搜索" VerticalAlignment="Center"/>
                        <TextBlock Text="Ctrl+F" Margin="18,0,0,0" Foreground="#9BA7B8" FontSize="11"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Popup>

    <!-- 设置菜单弹层 -->
    <Popup x:Name="SettingsMenuPopup" PlacementTarget="{Binding ElementName=GearButton}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
           Closed="OnSettingsMenuPopupClosed" VerticalOffset="4">
        <Border Style="{StaticResource FlyoutBorder}" Width="204">
            <StackPanel>
                <Button Click="OnOpenReadingColors" Style="{StaticResource CommandButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ColorIcon}" Style="{StaticResource MenuIcon}"/>
                        <TextBlock Text="阅读配色…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Popup>

    <!-- 帮助菜单弹层 -->
    <Popup x:Name="HelpMenuPopup" PlacementTarget="{Binding ElementName=HelpButton}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
           Closed="OnHelpMenuPopupClosed" VerticalOffset="4">
        <Border Style="{StaticResource FlyoutBorder}" Width="204">
            <StackPanel>
                <Button Click="OnOpenGuide" Style="{StaticResource CommandButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource BookIcon}" Style="{StaticResource MenuIcon}"/>
                        <TextBlock Text="快速上手…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnOpenShortcuts" Style="{StaticResource CommandButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource KeyboardIcon}" Style="{StaticResource MenuIcon}"/>
                        <TextBlock Text="键盘快捷键…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
