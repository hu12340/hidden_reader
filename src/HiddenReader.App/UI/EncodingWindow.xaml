<Window x:Class="HiddenReader.App.UI.EncodingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编码" Width="320" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource DialogWindowBrush}" Foreground="{StaticResource DialogForegroundBrush}">
    <!--
      编码切换对话框（UI-SPEC UI-04 / 2.4 统一资源）：只重新解码书库副本，原文件不受影响。
      确定/取消为共享三档按钮，确定是唯一主按钮。
    -->
    <Border BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1">
        <StackPanel Margin="16">
            <TextBlock x:Name="BookTitleText" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            <TextBlock Style="{StaticResource DialogHintText}" Margin="0,4,0,0"
                       Text="仅重新解码软件管理的副本，原文件不受影响。"/>
            <StackPanel x:Name="OptionsHost" Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource DialogSecondaryButton}" Content="取消" Width="64"
                        Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource DialogPrimaryButton}" Content="确定" Width="64"
                        IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
